{
  "name": "smart-journey",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "postinstall": "node scripts/patch-artopay-sdk.cjs",
    "lint": "tsc --noEmit",
    "test": "node scripts/test-sql-production-hardening.cjs"
  },
  "dependencies": {
    "@arto-pay/js-sdk": "^1.0.3",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pdfkit": "^0.17.6",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.1",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.4",
    "pdfkit": "^0.20.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.4",
    "sql.js": "^1.14.2",
    "vite": "7.3.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/sharp": "^0.32.0",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "7.3.6"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.4"
  }
